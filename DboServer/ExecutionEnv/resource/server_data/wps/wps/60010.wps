-- Sky Dungeon #1

-- References:
--     - https://www.youtube.com/watch?v=PwcayIRE44I
--     - https://www.youtube.com/watch?v=eNXMkp3E4EQ
-- 
-- Built on the retail spawn groups of spawn_mob_skdungeon_001_0X (identical to the
-- tw client copy). Patrol robots and Guard Robot Alerty walk their retail path ids,
-- see world_data/Path/DBO_SKDungeon_001_PATH.pth.
-- 
-- TODO: Missing text notifications on some events and mobs speaking
--       when pulled and so on.
-- 
-- Author(s): Tuo, Grender, Zebiru (OpenDBO)


GameStage( 0 )
--[
	-- Open the door
	Action( "change object state" )
	--[
		Param( "index", 1 )
		Param( "state", 1 )
	--]
	End()
------------------------------------------------------------------------
	-- Patrol robots (101), two scouts (102) and the door guard (111 + 103)
	Action( "add mobgroup" )
	--[
		Param( "group", 101 )
		Param( "no spawn wait", "true" )
	--]
	End()
	Action( "add mobgroup" )
	--[
		Param( "group", 102 )
		Param( "no spawn wait", "true" )
	--]
	End()
	Action( "add mobgroup" )
	--[
		Param( "group", 103 )
		Param( "no spawn wait", "true" )
	--]
	End()
	Action( "add mobgroup" )
	--[
		Param( "group", 111 )
		Param( "no spawn wait", "true" )
	--]
	End()
------------------------------------------------------------------------
	-- Wait until the door guard is engaged
	Action( "wait" )
	--[
		Param( "operation", "or" )
		Condition( "check battle" )
		--[
			Param( "type", "mob" )
			Param( "group", 111 )
			Param( "is battle", "true" )
		--]
		End()
		Condition( "check battle" )
		--[
			Param( "type", "mob" )
			Param( "group", 103 )
			Param( "is battle", "true" )
		--]
		End()
	--]
	End()
	-- Close the door and remove the patrol robots
	Action( "change object state" )
	--[
		Param( "index", 1 )
		Param( "state", 0 )
	--]
	End()
	Action( "remove mobgroup" )
	--[
		Param( "group", 101 )
		Param( "type", "clear" )
	--]
	End()
------------------------------------------------------------------------
	-- Wait until the scouts and the door guard are dead
	Action( "wait" )
	--[
		Condition( "check mobgroup" )
		--[
			Param( "group", 102 )
			Param( "count", 0 )
		--]
		End()
		Condition( "check mobgroup" )
		--[
			Param( "group", 103 )
			Param( "count", 0 )
		--]
		End()
		Condition( "check mobgroup" )
		--[
			Param( "group", 111 )
			Param( "count", 0 )
		--]
		End()
	--]
	End()
------------------------------------------------------------------------
	-- Second wave in the first area
	Action( "add mobgroup" )
	--[
		Param( "group", 104 )
		Param( "no spawn wait", "true" )
	--]
	End()
	Action( "direction indicate" )
	--[
		Param( "apply", "true" )
		Param( "indicate type", "point" )
		Param( "loc x", -924.97 )
		Param( "loc z", -123.6 )
	--]
	End()
	Action( "wait" )
	--[
		Condition( "check mobgroup" )
		--[
			Param( "group", 104 )
			Param( "count", 0 )
		--]
		End()
	--]
	End()
------------------------------------------------------------------------
	-- Enable the lever
	Action( "change object state" )
	--[
		Param( "index", 4 )
		Param( "state", 1 )
	--]
	End()
	Action( "wait" )
	--[
		Condition( "recv event from ts" )
		--[
			Param( "trigger type", "object" )
			Param( "event id", 1165 )
		--]
		End()
	--]
	End()
	Action( "wait" )
	--[
		Condition( "check time" )
		--[
			Param( "time", 3 )
		--]
		End()
	--]
	End()
------------------------------------------------------------------------
	-- Patrol robots, scouts and a new door guard (105)
	Action( "add mobgroup" )
	--[
		Param( "group", 105 )
		Param( "no spawn wait", "true" )
	--]
	End()
	-- Open the door
	Action( "change object state" )
	--[
		Param( "index", 1 )
		Param( "state", 1 )
		Param( "substate show", 1 )
	--]
	End()
	Action( "change object state" )
	--[
		Param( "index", 22 )
		Param( "state", 0 )
		Param( "substate show", 0 )
	--]
	End()
	Action( "direction indicate" )
	--[
		Param( "apply", "true" )
		Param( "indicate type", "point" )
		Param( "loc x", -1015.8 )
		Param( "loc z", -84.12 )
	--]
	End()
------------------------------------------------------------------------
	-- Second area
	Action( "add mobgroup" )
	--[
		Param( "group", 106 )
		Param( "no spawn wait", "true" )
	--]
	End()
	Action( "wait" )
	--[
		Condition( "area enter" )
		--[
			Param( "origin x", -1015.8 )
			Param( "origin z", -84.12 )
			Param( "radius", 5 )
			Param( "all member", "false" )
		--]
		End()
	--]
	End()
	Action( "wait" )
	--[
		Condition( "check mobgroup" )
		--[
			Param( "group", 106 )
			Param( "count", 0 )
		--]
		End()
	--]
	End()
	Action( "remove mobgroup" )
	--[
		Param( "group", 105 )
		Param( "type", "clear" )
	--]
	End()
------------------------------------------------------------------------
	-- Enable the lever
	Action( "change object state" )
	--[
		Param( "index", 5 )
		Param( "state", 1 )
	--]
	End()
	Action( "wait" )
	--[
		Condition( "recv event from ts" )
		--[
			Param( "trigger type", "object" )
			Param( "event id", 1166 )
		--]
		End()
	--]
	End()
	Action( "wait" )
	--[
		Condition( "check time" )
		--[
			Param( "time", 2 )
		--]
		End()
	--]
	End()
	-- Open the second door
	Action( "change object state" )
	--[
		Param( "index", 2 )
		Param( "state", 1 )
	--]
	End()
	Action( "direction indicate" )
	--[
		Param( "apply", "true" )
		Param( "indicate type", "point" )
		Param( "loc x", -1024.743 )
		Param( "loc z", -102.33 )
	--]
	End()
------------------------------------------------------------------------
	-- Third area: patrol robots (107) and the lever guard (108)
	Action( "add mobgroup" )
	--[
		Param( "group", 107 )
		Param( "no spawn wait", "true" )
	--]
	End()
	Action( "add mobgroup" )
	--[
		Param( "group", 108 )
		Param( "no spawn wait", "true" )
	--]
	End()
	Action( "wait" )
	--[
		Condition( "check mobgroup" )
		--[
			Param( "group", 108 )
			Param( "count", 0 )
		--]
		End()
	--]
	End()
------------------------------------------------------------------------
	-- Enable the lever
	Action( "change object state" )
	--[
		Param( "index", 6 )
		Param( "state", 1 )
	--]
	End()
	Action( "wait" )
	--[
		Condition( "recv event from ts" )
		--[
			Param( "trigger type", "object" )
			Param( "event id", 1167 )
		--]
		End()
	--]
	End()
	Action( "wait" )
	--[
		Condition( "check time" )
		--[
			Param( "time", 2 )
		--]
		End()
	--]
	End()
	-- Open the third door
	Action( "change object state" )
	--[
		Param( "index", 3 )
		Param( "state", 1 )
	--]
	End()
	Action( "direction indicate" )
	--[
		Param( "apply", "true" )
		Param( "indicate type", "point" )
		Param( "loc x", -1065.202 )
		Param( "loc z", -195.205 )
	--]
	End()
	Action( "remove mobgroup" )
	--[
		Param( "group", 107 )
		Param( "type", "clear" )
	--]
	End()
------------------------------------------------------------------------
	-- Final area with the boss (110)
	Action( "add mobgroup" )
	--[
		Param( "group", 109 )
		Param( "no spawn wait", "true" )
	--]
	End()
	Action( "add mobgroup" )
	--[
		Param( "group", 110 )
		Param( "no spawn wait", "true" )
	--]
	End()
	Action( "wait" )
	--[
		Condition( "check mobgroup" )
		--[
			Param( "group", 109 )
			Param( "count", 0 )
		--]
		End()
		Condition( "check mobgroup" )
		--[
			Param( "group", 110 )
			Param( "count", 0 )
		--]
		End()
	--]
	End()
------------------------------------------------------------------------
	-- Exit portal
	Action( "direction indicate" )
	--[
		Param( "apply", "true" )
		Param( "indicate type", "point" )
		Param( "loc x", -1056.087 )
		Param( "loc z", -151.637 )
	--]
	End()
	Action( "change object state" )
	--[
		Param( "index", 7 )
		Param( "state", 1 )
		Param( "substate show", 1 )
	--]
	End()
--]
End()
